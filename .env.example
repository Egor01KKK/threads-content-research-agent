# Optional logged-in session mode for an account you control.
THREADS_SESSION=
THREADS_CSRF=

# Optional XDG locations for the local cache and data directory.
XDG_CACHE_HOME=
XDG_DATA_HOME=

# Optional experimental content-analysis provider settings.
# The core CLI and viewer do not require these variables.
THREADS_ANALYSIS_PROVIDER=
THREADS_ANALYSIS_MODEL=
THREADS_ANALYSIS_API_KEY=
THREADS_ANALYSIS_ENDPOINT=
